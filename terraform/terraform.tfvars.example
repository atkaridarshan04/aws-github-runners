# Copy to terraform.tfvars (gitignored) and fill in your own values.

aws_region     = "us-east-1"
aws_account_id = "123456789012"
project_name   = "myproject"

scale_up_reserved_concurrent_executions = -1

# runner_extra_labels             = ["aws-spot"]   # workflows use: runs-on: [self-hosted, linux, x64, aws-spot]
# create_service_linked_role_spot = false          # optional once AWSServiceRoleForEC2Spot exists in the account

vpc_id     = "vpc-0123456789abcdef0"
subnet_ids = ["subnet-0123456789abcdef0", "subnet-0fedcba9876543210"]

tags = {
  Project     = "myproject"
  Environment = "shared"
}
